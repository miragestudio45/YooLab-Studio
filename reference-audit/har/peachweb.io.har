ds.com/website/16c65cb5-4775-4a9d-8308-12cfaea3c761/instrumentserif-regular.ttf\");font-family:instrumentserif-regular;}@font-face{src:url(\"https://files.peachworlds.com/website/fd64d257-136a-4dcd-b466-694abc6bdf40/instrumentserif-italic.ttf\");font-family:instrumentserif-italic;}@font-face{src:url(\"https://files.peachworlds.com/website/16c65cb5-4775-4a9d-8308-12cfaea3c761/instrumentserif-regular.ttf\");font-family:instrumentserif-regular;}@font-face{src:url(\"https://files.peachworlds.com/website/67ceb542-3b40-4b6f-a780-2744b8cef469/neuehaasdisplayroman.ttf\");font-family:neuehaasdisplayroman;}@font-face{src:url(\"https://files.peachworlds.com/website/16c65cb5-4775-4a9d-8308-12cfaea3c761/instrumentserif-regular.ttf\");font-family:instrumentserif-regular;}@font-face{src:url(\"https://files.peachworlds.com/website/67ceb542-3b40-4b6f-a780-2744b8cef469/neuehaasdisplayroman.ttf\");font-family:neuehaasdisplayroman;}@font-face{src:url(\"https://files.peachworlds.com/website/00d102c8-63f7-42d6-a6dd-f900aed652bb/neuehaasdisplaymediu.ttf\");font-family:neuehaasdisplaymediu;}@font-face{src:url(\"https://files.peachworlds.com/website/16c65cb5-4775-4a9d-8308-12cfaea3c761/instrumentserif-regular.ttf\");font-family:instrumentserif-regular;}@font-face{font-family:neuehaasdisplayroman;src:url(\"https://files.peachworlds.com/website/67ceb542-3b40-4b6f-a780-2744b8cef469/neuehaasdisplayroman.ttf\");}@font-face{font-family:neuehaasdisplayroman;src:url(\"https://files.peachworlds.com/website/67ceb542-3b40-4b6f-a780-2744b8cef469/neuehaasdisplayroman.ttf\");}@media (max-width: 992px){#ixe4zkj{bottom:48px;}}@media (max-width: 480px){#ixe4zkj{top:16px;left:24px;width:260px;position:static;}#im2i{top:0px;left:0px;right:0px;width:100dvw;bottom:0px;position:fixed;flex-direction:column;background-color:#000000;}#pwb-loading-wrap{background-color:#000000;}#if489kl{gap:8px;left:revert;top:revert;}#ifbapuu{bottom:32px;height:px;right:revert;}}\n        </style>\n      </head>\n      <body id=\"igpl\">\n        <script>\nfunction initVideoHoverWrapper(wrapper) {\n  const video = wrapper.querySelector(\".hover-video\");\n  const poster = wrapper.querySelector(\".video-poster\");\n  // Lazy-load the poster\n  if (poster && poster.dataset.src && !poster.src) {\n    poster.src = poster.dataset.src;\n  }\n  const playOnHover = () => {\n    if (!video.src) {\n      video.src = video.dataset.src;\n      video.load();\n      setTimeout(() => {\n        video.play().catch(() => {});\n      }, 100);\n    } else {\n      video.play().catch(() => {});\n    }\n    if (poster) poster.style.opacity = \"0\";\n  };\n  const pauseAndReset = () => {\n    video.pause();\n    video.currentTime = 0;\n    setTimeout(() => {\n      if (poster) poster.style.opacity = \"1\";\n    }, 100);\n  };\n  if (!wrapper._hoverAttached) {\n    wrapper.addEventListener(\"mouseenter\", playOnHover);\n    wrapper.addEventListener(\"mouseleave\", pauseAndReset);\n    wrapper._hoverAttached = true;\n  }\n}\nfunction observeNewVideoWrappers() {\n  const observer = new MutationObserver((mutations) => {\n    for (const mutation of mutations) {\n      mutation.addedNodes.forEach((node) => {\n        if (node.nodeType === 1) {\n          if (node.classList.contains(\"video-hover-wrapper\")) {\n            initVideoHoverWrapper(node);\n          }\n          // Also check children in case wrapper is nested\n          node.querySelectorAll?.(\".video-hover-wrapper\").forEach(initVideoHoverWrapper);\n        }\n      });\n    }\n  });\n  observer.observe(document.body, {\n    childList: true,\n    subtree: true,\n  });\n  // Also initialize existing ones on load\n  document.querySelectorAll(\".video-hover-wrapper\").forEach(initVideoHoverWrapper);\n}\n// Init everything on load\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  observeNewVideoWrappers();\n});\n</script>\n<script src=\"https://helpaipeach.vercel.app/widget.js\" defer></script>\n\n<!-- Mobile fix: keep the Peachweb chat popup within the screen on narrow viewports -->\n<style>\n  @media (max-width: 480px) {\n    #peach-widget-frame {\n      max-width: calc(100vw - 16px) !important;\n      right: 8px !important;\n    }\n  }\n</style>\n        \n\n        <div id=\"pwb-body-wrap\">\n          <div id=\"ip9j\" class=\"pwb-background pwb-flex-grid-wrap\"><div id=\"iwq9\" class=\"pwb-scene\"></div></div><div id=\"i9wvtj\" class=\"pwb-flex-grid-wrap\"><div id=\"icy7f\" class=\"pwb-flex-grid-wrap\"><div id=\"izog5sf\" class=\"pwb-flex-grid-wrap\"><div id=\"ij7r1nw\" class=\"pwb-flex-grid-wrap\"><div id=\"i5ca3tn\" class=\"pwb-flex-grid-wrap\"><div id=\"ixj1tk-2\" class=\"pwb-relative-overlay\"><div id=\"ir9fo-3\" class=\"pwb-flex-grid-wrap\"><div id=\"iv6dna-6\" class=\"pwb-flex-grid-wrap\"><img src=\"https://files.peachworlds.com/website/0850309e-2955-4bfa-bee9-9905708c98d3/logo-dark.png\" loading=\"lazy\" id=\"i335f-5\"/><div id=\"ipe2yfu-2\" class=\"pwb-flex-grid-wrap\"><img src=\"https://files.peachworlds.com/website/e81e868d-3c18-4257-9045-9ae4208e1ba5/close-24dp-ffffff-fill0-wght400-grad0-opsz24.png\" loading=\"lazy\" id=\"i335f-3-2-2-2-2-2-3-2\"/></div></div></div><div id=\"iv6dna-2-3\" class=\"pwb-flex-grid-wrap\"><div id=\"ipavn-6\" class=\"pwb-flex-grid-wrap\"><div id=\"i6wd7-2\" data-has-states=\"1\">Product</div><img src=\"https://files.peachworlds.com/website/c81480c6-a8de-4439-a170-57902c230610/arrow-forward-24dp-000000-fill0-wght400-grad0-opsz24.png\" loading=\"lazy\" id=\"i0073m-3-3-4\"/></div><div id=\"ipavn-2-3-4\" class=\"pwb-flex-grid-wrap\"><div id=\"i6wd7-2-3-4\" data-has-states=\"1\">Resources</div><img src=\"https://files.peachworlds.com/website/c81480c6-a8de-4439-a170-57902c230610/arrow-forward-24dp-000000-fill0-wght400-grad0-opsz24.png\" loading=\"lazy\" id=\"i0073m-3-3-4-2\"/></div><div id=\"ipavn-2-6\" class=\"pwb-flex-grid-wrap\"><div id=\"i6wd7-2-6-2\" data-has-states=\"1\">Use Cases</div><img src=\"https://files.peachworlds.com/website/c81480c6-a8de-4439-a170-57902c23061
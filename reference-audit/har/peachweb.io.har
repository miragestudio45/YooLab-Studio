            "size": 85447,
            "mimeType": "text/html",
            "text": "\n    <!doctype html>\n    <html lang=\"en\">\n      <head>\n        <!-- Google tag (gtag.js) -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-VQCPB2Z7N9\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n\n  gtag('config', 'G-VQCPB2Z7N9');\n</script>\n\n<link \n  rel=\"preload\" \n  as=\"image\" \n  href=\"https://files.peachworlds.com/website/f737228e-397d-4cf5-b142-af5b159c0484\" \n  fetchpriority=\"high\"\n  imagesrcset=\"https://files.peachworlds.com/website/f737228e-397d-4cf5-b142-af5b159c0484\" \n  imagesizes=\"100vw\" \n>\n\n\n        \n        <title>PeachWeb I Stunning Interactive 3D Websites Without Code</title>\n        <meta charset=\"utf-8\" />\n        <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\n        <meta name=\"theme-color\" content=\"#000000\" />\n        <meta name=\"description\" content=\"PeachWeb lets you build high-performance, stunning 3D websites—no code needed. Use our no-code builder or hire an expert. Fast, interactive, and perfect for designers and brands.\" />\n        <meta property=\"og:title\" content=\"PeachWeb I Stunning Interactive 3D Websites Without Code\"/>\n        <meta property=\"og:description\" content=\"PeachWeb lets you build high-performance, stunning 3D websites—no code needed. Use our no-code builder or hire an expert. Fast, interactive, and perfect for designers and brands.\" />\n        <meta property=\"og:image\" content=\"/meta-peachweb.webp\" />\n        <meta property=\"og:url\" content=\"https://www.peachweb.io/\" />\n        <meta property=\"og:type\" content=\"website\" />\n        <link rel=\"icon\" href=\"/peachweb-favico2n.png\" />\n        <link href=\"/website-base.css\" rel=\"stylesheet\" />\n        <link href=\"/styles.css\" rel=\"stylesheet\" />\n        \n    <link href=\"https://fonts.gstatic.com\" rel=\"preconnect\" crossorigin=\"\" />\n    <link href=\"https://fonts.googleapis.com\" rel=\"preconnect\" />\n    <link href=\"https://fonts.googleapis.com/css?family=Inter:100,200,300,400,500,600,700,800,900&display=swap\" rel=\"stylesheet\" /><link href=\"https://fonts.googleapis.com/css?family=sans-serif:100,200,300,400,500,600,700,800,900&display=swap\" rel=\"stylesheet\" />\n  \n        <script>        window._pwInitialPath = \"/\";\n</script>\n        <script defer=\"defer\" fetchpriority=\"high\" src=\"/script.js\"></script>\n        <script>\nfunction initLazyVideoWrapper(wrapper) {\n  if (wrapper._lazyInitialized) return;\n  wrapper._lazyInitialized = true;\n\n  const video = wrapper.querySelector('.lazy-video');\n  const videoSrc = video?.dataset?.src || \"https://files.peachworlds.com/website/0e5f237e-0e45-4db9-8798-8e340bff43f0/peachwebsitevideo-2b.mp4\";\n\n  let isLazyVideoLoaded = false;\n  let observersInitialized = false;\n\n  function loadVideoSafely() {\n    if (isLazyVideoLoaded) return;\n    const doLoad = () => {\n      if (isLazyVideoLoaded) return;\n      const source = document.createElement('source');\n      source.src = videoSrc;\n      source.type = 'video/mp4';\n      video.appendChild(source);\n      video.load();\n      isLazyVideoLoaded = true;\n      setupPlayPauseObserver();\n    };\n    if ('requestIdleCallback' in window) {\n      requestIdleCallback(doLoad, { timeout: 2000 });\n    } else {\n      setTimeout(doLoad, 500);\n    }\n  }\n\n  function setupPlayPauseObserver() {\n    if (observersInitialized) return;\n    observersInitialized = true;\n    const observer = new IntersectionObserver((entries) => {\n      entries.forEach((entry) => {\n        if (!isLazyVideoLoaded) return;\n        if (entry.isIntersecting) {\n          video.play().catch(() => {});\n        } else {\n          video.pause();\n        }\n      });\n    }, { threshold: 0.1 });\n\n    const container = wrapper.querySelector('.video-container');\n    if (container) observer.observe(container);\n  }\n\n  const preloadObserver = new IntersectionObserver(\n    (entries, observer) => {\n      entries.forEach((entry) => {\n        if (entry.isIntersecting && !isLazyVideoLoaded) {\n          loadVideoSafely();\n          observer.disconnect();\n        }\n      });\n    },\n    { threshold: 0, rootMargin: '500px 0px 0px 0px' }\n  );\n\n  preloadObserver.observe(wrapper);\n\n  window.addEventListener('scroll', function onScroll() {\n    if (!isLazyVideoLoaded) {\n      loadVideoSafely();\n    }\n    window.removeEventListener('scroll', onScroll);\n  }, { once: true });\n}\n\nfunction observeNewLazyVideoWrappers() {\n  const observer = new MutationObserver((mutations) => {\n    for (const mutation of mutations) {\n      mutation.addedNodes.forEach((node) => {\n        if (node.nodeType !== 1) return;\n\n        if (node.classList.contains(\"video-container-wrapper\")) {\n          initLazyVideoWrapper(node);\n        }\n\n        node.querySelectorAll?.('.video-container-wrapper').forEach(initLazyVideoWrapper);\n      });\n    }\n  });\n\n  observer.observe(document.body, {\n    childList: true,\n    subtree: true,\n  });\n\n  // Initialize any already-present embeds\n  document.querySelectorAll('.video-container-wrapper').forEach(initLazyVideoWrapper);\n}\n\ndocument.addEventListener('DOMContentLoaded', () => {\n  observeNewLazyVideoWrappers();\n});\n</script>\n\n        <meta name=\"pw:has-visual-script\" content=\"false\" />\n        <link rel=\"preload\" media=\"screen and (max-width: 768)\" href=\"/scene-state/7a38b385-c817-4e66-8d96-8cad23a6b0d9.json\" as=\"fetch\" crossorigin=\"anonymous\"/>\n<link rel=\"preload\" media=\"screen and (max-width: 768)\" href=\"https://files.peachworlds.com/website/3c643e19-ea8e-4832-b3af-3c728c259ad7/particle.glb\" as=\"fetch\" crossorigin=\"anonymous\"/>\n<link rel=\"preload\" media=\"screen and (max-width: 768)\" href=\"https://files.peachworlds.com/website/fff76a6a-75d3-471d-8dcf-35935115362f/kloofendal-48d-partly-c
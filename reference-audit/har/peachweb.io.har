><div id=\"i6wd7-2-2-2-2-2-2-2-2-2-3-3\" data-has-states=\"1\"><font id=\"i00y82-3-3\" face=\"neuehaasdisplayroman\">Book a Call</font></div></div></div><div id=\"ioqrg-2-2-2-2-3-3\" data-has-states=\"1\" class=\"pwb-flex-grid-wrap\"><div id=\"ipavn-2-2-2-2-2-2-2-2-3-3\" class=\"pwb-flex-grid-wrap\"><div id=\"i6wd7-2-2-2-2-2-2-2-2-3-3\"><span id=\"ic0tx-2-2-2-2-2-3\">Get started</span> — it's free</div></div></div></div><div id=\"ixixypg\">No-Code <br id=\"i5xegg\"/>3D Website Builder.<br id=\"irxpwf\"/></div><div id=\"iwkqnlt\" class=\"pwb-flex-grid-wrap\"><div id=\"i48vgbe\" data-has-states=\"1\" class=\"pwb-flex-grid-wrap\"><div id=\"i81on86\" class=\"pwb-flex-grid-wrap\"><div id=\"iq63fpg\" data-has-states=\"1\">Book a Call</div></div></div><div id=\"i48vgbe-3\" data-has-states=\"1\" class=\"pwb-flex-grid-wrap\"><div id=\"i81on86-3\" class=\"pwb-flex-grid-wrap\"><div id=\"iq63fpg-3\" data-has-states=\"1\">Get Started</div></div></div></div><div id=\"i6vxg7-3\" class=\"pwb-flex-grid-wrap\"><div id=\"ik754i-3-2\" class=\"pwb-flex-grid-wrap\"><div id=\"ioqrg-3\" data-has-states=\"1\" class=\"pwb-flex-grid-wrap\"><div id=\"ipavn-3\" class=\"pwb-flex-grid-wrap\"><div id=\"i6wd7-3\" data-has-states=\"1\">Experience</div><img src=\"https://files.peachworlds.com/website/61399ee3-0db7-43a9-a528-4212df5dbdc5/right-arrow-4-.svg\" loading=\"lazy\" id=\"ik5hzn\"/></div><div id=\"imob0j-2-2\" class=\"framer-1cc0f02\"></div></div><div id=\"in3nlcf-7-2\" class=\"pw-no-class-fix pwb-embed\"><style>\n  .video-container-wrapper {\n    position: relative;\n    height: 100%;\n    width: 100%;\n  }\n  .video-container {\n    aspect-ratio: 16 / 9;\n    width: 100%;\n    position: relative;\n    overflow: hidden;\n    border-radius: 32px;\n    background-color: #000; /* Fallback background while video loads */\n  }\n  .lazy-video {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    background-color: #000;\n  }\n</style>\n\n<div class=\"video-container-wrapper\">\n  <div class=\"video-container\">\n    <video class=\"lazy-video\" loop muted playsinline preload=\"none\"></video>\n  </div>\n</div>\n\n<script>\n  document.querySelectorAll('.video-container-wrapper').forEach((wrapper, index) => {\n    const video = wrapper.querySelector('.lazy-video');\n    const videoSrc = \"https://files.peachworlds.com/website/0e5f237e-0e45-4db9-8798-8e340bff43f0/peachwebsitevideo-2b.mp4\";\n    let isLazyVideoLoaded = false;\n    let observersInitialized = false;\n\n    function loadVideoSafely() {\n      if (isLazyVideoLoaded) return;\n      const doLoad = () => {\n        if (isLazyVideoLoaded) return;\n        console.log(`Embed ${index}: preloading video (idle-safe)...`);\n        const source = document.createElement('source');\n        source.src = videoSrc;\n        source.type = 'video/mp4';\n        video.appendChild(source);\n        video.load();\n        isLazyVideoLoaded = true;\n        setupPlayPauseObserver();\n      };\n      if ('requestIdleCallback' in window) {\n        requestIdleCallback(doLoad, { timeout: 2000 });\n      } else {\n        setTimeout(doLoad, 500);\n      }\n    }\n\n    function setupPlayPauseObserver() {\n      if (observersInitialized) return;\n      observersInitialized = true;\n      const playPauseObserver = new IntersectionObserver((entries) => {\n        entries.forEach((entry) => {\n          if (!isLazyVideoLoaded) return;\n          if (entry.isIntersecting) {\n            console.log(`Embed ${index}: playing video...`);\n            video.play();\n          } else {\n            console.log(`Embed ${index}: pausing video...`);\n            video.pause();\n          }\n        });\n      }, { threshold: 0.1 });\n      playPauseObserver.observe(wrapper.querySelector('.video-container'));\n    }\n\n    // Failsafe preload if it enters viewport first\n    const preloadObserver = new IntersectionObserver(\n      (entries, observer) => {\n        entries.forEach((entry) => {\n          if (entry.isIntersecting && !isLazyVideoLoaded) {\n            loadVideoSafely();\n            observer.disconnect();\n          }\n        });\n      },\n      { threshold: 0, rootMargin: '500px 0px 0px 0px' }\n    );\n\n    preloadObserver.observe(wrapper);\n\n    // User scroll-triggered preload (only once)\n    function onFirstScroll() {\n      if (!isLazyVideoLoaded) {\n        loadVideoSafely();\n      }\n      window.removeEventListener('scroll', onFirstScroll);\n    }\n\n    window.addEventListener('scroll', onFirstScroll, { once: true });\n  });\n</script>\n</div></div></div><div id=\"in6nbcy-4-3-2\" class=\"pwb-flex-grid-wrap\"><div id=\"in6nbcy-2-4-3-2\" class=\"pwb-flex-grid-wrap\"><div id=\"imob0j-3-2-3-5-3-2\" class=\"framer-1cc0f02\"><div id=\"i2omk-2-2-3-3-5-2-2-2-2-4-3-2\">Step 1</div><div id=\"i2omk-2-2-3-3-7-3-2\">Tell us About Yourself</div><div id=\"iqlxmn9-3-6-3\" class=\"pwb-flex-grid-wrap\"><img src=\"https://files.peachworlds.com/website/b917ff53-f4ea-4283-972c-36e13d97aba4/cube.webp\" loading=\"lazy\" id=\"i1j7jnd-2-3\" data-has-states=\"1\"/><img src=\"https://files.peachworlds.com/website/40ab35c4-227a-403b-aa46-6dd39a84da1f/mindyhve.webp\" loading=\"lazy\" id=\"i2ekftl-2-3\" data-has-states=\"1\"/></div><div id=\"iqlxmn9-3-6-2-2\" class=\"pwb-flex-grid-wrap\"><img src=\"https://files.peachworlds.com/website/1177eb3a-5261-402f-a4b5-6916a4813789/snkr.webp\" loading=\"lazy\" id=\"i2ekftl-2-2-2\" data-has-states=\"1\"/><img src=\"https://files.peachworlds.com/website/b18486a0-d5d6-4cb2-a38a-008f1ca092e5/vxl1.webp\" loading=\"lazy\" id=\"i1j7jnd-2-2-2\" data-has-states=\"1\"/></div></div></div><div id=\"in6nbcy-2-3-4-2-2\" class=\"pwb-flex-grid-wrap\"><div id=\"imob0j-3-2-3-3-3-2-2\" class=\"framer-1cc0f02\"><div id=\"i2omk-2-2-3-3-5-2-2-2-2-2-3-2-2\">Step 2</div><div id=\"i2omk-2-2-3-3-3-3-2-2\">Pick Your Theme</div><div id=\"iqlxmn9-3-3-2-2\" class=\"pwb-flex-grid-wrap\"><img src=\"https://files.peachworlds.com/website/3f9c55ff-8cee-4aaf-9
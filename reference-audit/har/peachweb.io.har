a-has-states=\"1\"/><img src=\"https://files.peachworlds.com/website/40ab35c4-227a-403b-aa46-6dd39a84da1f/mindyhve.webp\" loading=\"lazy\" id=\"i2ekftl-2\" data-has-states=\"1\"/></div><div id=\"iqlxmn9-3-6-2\" class=\"pwb-flex-grid-wrap\"><img src=\"https://files.peachworlds.com/website/1177eb3a-5261-402f-a4b5-6916a4813789/snkr.webp\" loading=\"lazy\" id=\"i2ekftl-2-2\" data-has-states=\"1\"/><img src=\"https://files.peachworlds.com/website/b18486a0-d5d6-4cb2-a38a-008f1ca092e5/vxl1.webp\" loading=\"lazy\" id=\"i1j7jnd-2-2\" data-has-states=\"1\"/></div></div></div><div id=\"in6nbcy-2-3-4-2\" class=\"pwb-flex-grid-wrap\"><div id=\"imob0j-3-2-3-3-3-2\" class=\"framer-1cc0f02\"><div id=\"i2omk-2-2-3-3-5-2-2-2-2-2-3-2\">Step 2</div><div id=\"i2omk-2-2-3-3-3-3-2\">Pick Your Theme</div><div id=\"iqlxmn9-3-3-2\" class=\"pwb-flex-grid-wrap\"><img src=\"https://files.peachworlds.com/website/3f9c55ff-8cee-4aaf-98e0-97d01dcdfe95/layout.webp\" loading=\"lazy\" id=\"i1j7jnd-3-3\"/></div></div></div><div id=\"in6nbcy-2-3-2-3-2\" class=\"pwb-flex-grid-wrap\"><div id=\"imob0j-3-2-3-2-3-2\" class=\"framer-1cc0f02\"><div id=\"i2omk-2-2-3-3-5-2-2-2-4-2\">Step 3</div><div id=\"i2omk-2-2-3-3-2-3-2\">Edit &amp; Launch</div><div id=\"iqlxmn9-3-5-2\" class=\"pwb-flex-grid-wrap\"></div><img src=\"https://files.peachworlds.com/website/07e43f7d-b120-43c6-bd4a-d2529f26387d/vxl.webp\" loading=\"lazy\" id=\"i1j7jnd-3-2-2\"/></div></div></div><div id=\"improb-2-2\" class=\"pw-no-class-fix pwb-embed\"><style>\n  body {\n    margin: 0;\n    font-family: sans-serif;\n    background: black;\n  }\n\n  .carousel-container {\n    overflow: hidden;\n    width: 100%;\n    background: none;\n  }\n\n  .carousel-track {\n    display: flex;\n    width: max-content;\n    will-change: transform;\n  }\n\n  .carousel-item {\n    display: inline-flex; height: 48px;\n    align-items: center;\n    justify-content: flex-start;\n    background-color: #00F0FF;\n    padding: 12px 16px;\n    margin-right: 24px;\n    border-radius: 24px;\n    flex-shrink: 0;\n    white-space: nowrap;\n  }\n\n  .carousel-item img {\n    width: 32px;\n    height: 32px;\n    margin-right: 10px;\n    flex-shrink: 0;\n  }\n\n  .carousel-item span {\n    color: black;\n    font-size: 18px;\n  }\n</style>\n\n<div class=\"carousel-container\">\n  <div class=\"carousel-track\" id=\"carousel-track\">\n    <!-- Tiles will be added by JS -->\n  </div>\n</div>\n\n<script>\n  const features = [\n    \"Wow Factor\",\n    \"Stand Out\",\n    \"Captivate\",\n    \"Innovative\",\n    \"Best Visuals\",\n    \"Engaging\",\n    \"Interactive\",\n    \"WebGL\",\n    \"Cinematic\",\n    \"Storytelling\"\n  ];\n\n  const icon = \"https://files.peachworlds.com/website/2ead1973-e94a-4343-8f32-ef9631ad0cff/icon-star.svg\";\n  const track = document.getElementById(\"carousel-track\");\n\n  [...features, ...features].forEach(label => {\n    const item = document.createElement('div');\n    item.className = 'carousel-item';\n    item.innerHTML = `\n      <img src=\"${icon}\" alt=\"\">\n      <span>${label}</span>\n    `;\n    track.appendChild(item);\n  });\n\n  let scrollX = 0;\n  const speed = 0.5;\n\n  function animate() {\n    scrollX -= speed;\n    if (Math.abs(scrollX) >= track.scrollWidth / 2) {\n      scrollX = 0;\n    }\n    track.style.transform = `translateX(${scrollX}px)`;\n    requestAnimationFrame(animate);\n  }\n\n  animate();\n</script>\n</div></div></div><div id=\"i0loz7-3-2-2-4\" class=\"pwb-flex-grid-wrap\"></div><div id=\"iee4h3-3-2-2-2-2-2-4-3\" class=\"pwb-anchor\"></div><div id=\"i0loz7-3-2-2-2\" class=\"pwb-flex-grid-wrap\"></div><div id=\"iee4h3-3-2-2-2-2-2-4-2\" class=\"pwb-anchor\"></div><div id=\"i0loz7-3-2-2-3\" class=\"pwb-flex-grid-wrap\"></div><div id=\"iee4h3-3-2-2-2-2-2-4-2-2\" class=\"pwb-anchor\"></div><div id=\"ibdecd\" class=\"pwb-flex-grid-wrap\"><div id=\"imqgmk-2-2\" class=\"pwb-flex-grid-wrap\"><div id=\"ixycwt-2-2-3\" class=\"pwb-flex-grid-wrap\"><img src=\"https://files.peachworlds.com